<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Losowanie kostek"
            android:textStyle="bold"
            android:textSize="28sp"
             />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liczba kostek:"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/poleKostek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Podaj liczbę kostek"
            android:inputType="number"
            android:text="5" />

        <Button
            android:id="@+id/Losuj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LOSUJ" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Wylosowane kostki: "/>

        <GridLayout
            android:id="@+id/poleKostekk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="1"
            android:gravity="center"
            android:useDefaultMargins="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wyniki:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wynikTextt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="Wyniki pojawią się tutaj"
            android:textSize="20sp" />

        <Button
            android:id="@+id/sortujRosnaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="posortuj rosnąco" />

        <Button
            android:id="@+id/sortujMalejaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="posortuj malejąco" />

    </LinearLayout>

</ScrollView>
